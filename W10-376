class Solution {
public:
    int wiggleMaxLength(vector<int>& nums) {
        int curr=0,pre=0,result=1;
        if (nums.size()<2)
            return nums.size();
        for (int i=1;i<nums.size();i++){
            curr=nums[i]-nums[i-1];
            if((curr>0&&pre<=0)||(curr<0&&pre>=0)){
                pre=curr;
                result+=1;
            }
            
        }
        return result;
    }
};
