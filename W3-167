class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        int left = 0;
    int right = numbers.size() - 1;
    
    while (left < right) {
        int sum = numbers[left] + numbers[right];
        
        if (sum == target) {
            // 題目要求回傳從1開始算的索引所以要+1
            return {left + 1, right + 1};
        } else if (sum < target) {
            left++; // 太小，左邊往右移一點
        } else {
            right--; // 太大，右邊往左移一點
        }
    }
    return {};
    }
};
